<footer class="pt-3 my-4">
  <ul class="nav justify-content-center border-bottom pb-3 mb-3">
    <% if (locals.footer) { %>
      <% locals.footer.forEach(f => { %>
        <li class="nav-item">
          <a href="#<%=f.id%>" class="nav-link px-2 text-body-secondary"><%=f.title%></a>
        </li>
      <% }) %>
    <% } %>
  </ul>
  <p class="text-center text-body-secondary">
    <small>© 2025 Tam Ly. All Right Reserved.</small>
    <br />
    <small>Book cover images from Open Library and other online resources.</small>
    <br />
    <small>All opinions expressed are personal and do not reflect those of authors or publishers.</small>
    <br />
    <small>Interface and layout inspired by Leona’s design aesthetic.</small>
  </p>
</footer>
