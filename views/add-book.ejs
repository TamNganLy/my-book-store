<section class="detail-container">
  <div class="add-book-container">
    <div class="first">
      <img
        src="/images/cherry-blossom-branch.png"
        alt="break image"
        height="75"
      />
      <h1>Add New Book</h1>
      <img
        src="/images/cherry-blossom-branch.png"
        alt="break image"
        height="75"
      />
    </div>

    <% if (locals.error) { %>
      <div class="error">
        <p><%= locals.error%></p>
      </div>
    <% }  %>

    <div>
      <form action="/add-book" method="POST" >
        <label for="title">Title *</label>
        <input class="input" type="text" name="title" id="title" required value="<%=locals.new_book ? locals.new_book.title : '' %>"/>

        <label for="isbn">Isbn *</label>
        <input class="input" type="text" name="id" id="id" required value="<%=locals.new_book ? locals.new_book.id : '' %>"/>

        <label for="author">Author</label>
        <input class="input" type="text" name="author" id="author" />
        
        <label for="description">Description</label>
        <textarea class="input" type="text" name="description" id="description" rows="5" ></textarea>

        <label for="rate">Rate *</label>
        <div class="input input-rate">
          <div class="rate-selected" ><%=locals.new_book ? locals.new_book.rate : "Select rating" %></div>
          <ul class="rate-options">
            <li data-value="1">1</li>
            <li data-value="2">2</li>
            <li data-value="3">3</li>
            <li data-value="4">4</li>
            <li data-value="5">5</li>
          </ul>
        </div>
        <input type="text" name="rate" id="rate" required class="rate-hidden-input" value="<%=locals.new_book ? locals.new_book.rate : '' %>"/>


        <label for="genre">Genre</label>
        <input class="input" type="text" name="genre" id="genre" />
        <br />
        <div class="form-btn">
          <input class="btn btn-secondary" type="submit" value="Save" />
        </div>
      </form>
    </div>
  </div>

</section>